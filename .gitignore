# 二进制
omni
/omni
omni.exe

# 依赖
go.sum.bak

# 本地会话
.omni-sessions/
/omni.exe~
/.zcode

# webui 前端
webui/frontend/node_modules/
.npm-tmp-cache/
.npm-cache/
webui/desktop/node_modules/

# 内置 ffmpeg/ffprobe 的下载缓存（scripts/fetch-ffmpeg.mjs）
.ffmpeg-cache/

# ZCode 会话数据
.zcode/

# 桌面版打包产物与内核副本
webui/desktop/bin/
webui/desktop/release/

# dev MCP 服务器：源码入库，构建出的 exe 不入库
dev/bin/

# WorkBuddy 临时文件（调试脚本等）
.workbuddy/tmp/

# 调试日志（约定写到 .omni/log/）
.omni/log/

# 自研 MCP 服务器的运行时状态
.omni/mcp/

# H5 窄屏预览用的临时 iframe 宿主页（本地起静态服务器用，不入库）
.omni/h5/

# Windows 误建的垃圾文件：cmd 风格 `> nul` 在 bash 下会真的创建
/nul
NUL

# 编译产物与本地数据：exe 不入库
*.exe
*.exe~
# Worker 端依赖与 wrangler 缓存
server_cloudflare/node_modules/
server_cloudflare/web/node_modules/
server_cloudflare/.wrangler/
/.workbuddy
